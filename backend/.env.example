ESTETICA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ns_estetica
DATABASE_SSL=false
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BUSINESS_SLUG=natalia-sanchez-estetica
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=
# Opt-in only: initializes business, hours, service catalog and staff from reviewed seed.
SEED_BUSINESS=false
# Optional one-time accounts; remove these variables after the first successful start.
INITIAL_ACCOUNT_EMAIL=
INITIAL_MANAGER_USERNAME=natalia
INITIAL_ADMIN_PASSWORD=
INITIAL_MANAGER_PASSWORD=
# Cloudflare Email Service. Keep the token exclusively in backend secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
PANEL_ORIGIN=http://localhost:3001
# Enable only after domain/sender and recipient are verified. Sends one daily summary.
NOTIFICATION_EMAIL_ENABLED=false
# Customer booking activation: keep false until test payments, Google and email delivery are verified.
CUSTOMER_BOOKING_ENABLED=false
# Initial defaults. Values saved in Mi Comercio take precedence, without redeploying.
BOOKING_DEPOSIT_PERCENT=50
GOOGLE_LOGIN_ENABLED=true
CUSTOMER_SITE_URL=http://localhost:3000
# Two different random secrets, at least 32 characters. Proxy secret also goes in the PUBLIC site's Vercel server variables.
CUSTOMER_PROXY_SECRET=
CUSTOMER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
MP_MODE=test
MP_ACCESS_TOKEN=
MP_COLLECTOR_ID=
MP_WEBHOOK_SECRET=
BOOKING_HOLD_MINUTES=15
